# 统一换行，避免跨平台协作时产生整文件 diff
* text=auto eol=lf

# Windows 批处理必须保持 CRLF，否则可能无法执行
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Gradle wrapper 脚本
gradlew      text eol=lf
gradlew.bat  text eol=crlf

# 二进制文件不做换行转换
*.jar    binary
*.png    binary
*.jpg    binary
*.ogg    binary
*.zip    binary

# 语言统计时排除验证脚本目录，避免 Python 盖过 Java
spikes/** linguist-vendored
docs/**   linguist-documentation
